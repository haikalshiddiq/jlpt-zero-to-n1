---
import Base from '../layouts/Base.astro';
import { grammar } from '../lib/curriculum';
import { toRomaji } from '../utils/romaji';
---
<Base title="Grammar">
  <div class="glass">
    <h1 style="margin:0 0 8px;font-size:1.75rem;font-weight:800">Grammar Builder</h1>
    <p class="lead">Grammar patterns with romaji pronunciation so beginners can read aloud while learning.</p>
  </div>
  <section class="grid">
    {grammar.map((grammarItem) => (
      <div class="card">
        <span class="badge">{grammarItem.level}</span>
        <h2 style="margin:8px 0 4px;font-weight:700">{grammarItem.pattern}</h2>
        <p class="pronunciation compact"><span>Pattern pronunciation</span>{toRomaji(grammarItem.pattern)}</p>
        <h3 style="margin:8px 0 4px;font-size:1.1rem;font-weight:600">{grammarItem.meaning}</h3>
        <p style="color:var(--color-ink-secondary)">{grammarItem.use}</p>
        <p class="muted">Common mistake: {grammarItem.mistake}</p>
        <ul class="example-list">
          {grammarItem.examples.map((example: string) => (
            <li>
              <span class="jp-example">{example}</span>
              <br/>
              <span class="pronunciation inline">{toRomaji(example)}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Base>
