---
import Base from '../layouts/Base.astro';
import GuideSubnav from '../components/GuideSubnav.astro';
import { kanjiNavigation } from '../data/japan-navigation';
import kanjiVisuals from '../data/kanji-visuals.json';
import '../styles/kanji-memory.css';
import '../styles/japan-life.css';

const visualByCharacter = new Map(kanjiVisuals.map((visual) => [visual.char, visual]));
const chapterVisuals = ['日', '人', '山'];
const chapters = kanjiNavigation.slice(1).map((chapter, index) => ({ ...chapter, visual: visualByCharacter.get(chapterVisuals[index]) }));
---
<Base pageClass="japan-page kanji-deck-page guide-hub-page" title="Kanji Memory | JLPT Zero to N1" description="Choose one short illustrated Kanji chapter and study foundation characters with mnemonics, readings, audio, examples, and review.">
  <GuideSubnav guide="kanji" />
  <header class="guide-hub-hero kanji-hub-hero">
    <div class="hero-copy">
      <p class="japan-kicker"><span>漢</span> Kanji Memory</p>
      <h1>Choose a chapter.<br /><em>Study fewer at once.</em></h1>
      <p class="japan-intro">The 20 foundation Kanji are now divided into three shorter study pages with the same audio and review tools.</p>
    </div>
    <div class="kanji-hub-collage" role="img" aria-label="Illustrated Kanji chapter preview">
      {chapters.map((chapter) => chapter.visual && <img src={chapter.visual.src} alt="" width="960" height="600" loading="eager" decoding="async" />)}
    </div>
  </header>

  <section class="kanji-chapter-menu" aria-label="Kanji chapters">
    {chapters.map((chapter) => (
      <article>
        {chapter.visual && <img src={chapter.visual.src} alt={chapter.visual.alt} width="960" height="600" loading="lazy" decoding="async" />}
        <div><span lang="ja">{chapter.japanese}</span><h2>{chapter.title}</h2><p>{chapter.summary}</p><a href={chapter.href}>Study this chapter</a></div>
      </article>
    ))}
  </section>
</Base>
