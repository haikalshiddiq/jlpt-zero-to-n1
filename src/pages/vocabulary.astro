---
import Base from '../layouts/Base.astro';
import { vocabulary } from '../lib/curriculum';
import { toRomaji } from '../utils/romaji';
---
<Base title="Kotoba Memory | Japanese Vocabulary">
  <header class="glass memory-hero">
    <div>
      <p class="eyebrow">Kotoba memory deck</p>
      <h1>Memorize Japanese Vocabulary</h1>
      <p class="lead">Hear the word, recall its meaning, flip the card, then grade your memory.</p>
    </div>
    <div class="memory-summary" aria-label="Vocabulary total">
      <strong>{vocabulary.length}</strong>
      <span>foundation words</span>
    </div>
  </header>

  <section class="card memory-guide">
    <div><b>Listen</b><span>Play the Japanese word before reading the answer</span></div>
    <div><b>Recall</b><span>Say the meaning aloud, then flip the card</span></div>
    <div><b>Repeat</b><span>Save forgotten words to your review queue</span></div>
  </section>

  <section class="grid kotoba-grid">
    {vocabulary.map((vocabItem: any) => (
      <div class="flashcard">
        <div class="flashcard-inner">
          <div class="front">
            <span class="badge">{vocabItem.level}</span>
            <div class="jp">{vocabItem.jp}</div>
            <div class="pronunciation">
              <span>Reading</span>
              {vocabItem.reading || toRomaji(vocabItem.jp)}
            </div>
            <div class="memory-actions">
              <button class="btn audio-button" type="button" data-speak={vocabItem.jp} data-rate="0.72">Play word</button>
              <button class="btn secondary" type="button" data-flip>Reveal meaning</button>
            </div>
          </div>
          <div class="back">
            <span class="badge">{vocabItem.level}</span>
            <h2>{vocabItem.meaning}</h2>
            <p class="jp-example">{vocabItem.example}</p>
            <p class="pronunciation compact">
              <span>Example reading</span>
              {toRomaji(vocabItem.example)}
            </p>
            <p class="muted">{vocabItem.note}</p>
            <div class="memory-actions">
              <button class="btn audio-button" type="button" data-speak={vocabItem.example} data-rate="0.72">Play example</button>
              <button class="btn secondary" type="button" data-review="easy" data-item={vocabItem.jp}>I know it</button>
              <button class="btn secondary" type="button" data-review="forgot" data-item={vocabItem.jp}>Review again</button>
              <button class="memory-link" type="button" data-flip>Back to word</button>
            </div>
          </div>
        </div>
      </div>
    ))}
  </section>
  <p class="audio-status" data-audio-status aria-live="polite">Press “Play word” and repeat the pronunciation aloud.</p>
</Base>
