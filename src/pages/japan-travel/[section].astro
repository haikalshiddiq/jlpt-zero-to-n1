---
import Base from '../../layouts/Base.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import GuideSubnav from '../../components/GuideSubnav.astro';
import { itinerary, secondhandStores, shoppingSpots } from '../../data/japan-life';
import { travelNavigation } from '../../data/japan-navigation';
import japanImages from '../../data/japan-image-credits.json';
import '../../styles/japan-life.css';

export function getStaticPaths() {
  return travelNavigation.slice(1).map((page) => ({ params: { section: page.href.split('/').pop() }, props: { page } }));
}

const { page } = Astro.props;
const imageById = Object.fromEntries(japanImages.map((image) => [image.id, image]));
const editorialImage = imageById[page.imageId ?? 'travel-hero'];
const slug = page.href.split('/').pop();
const mapLink = (query: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query + ', Japan')}`;
const typeLabels = { visit: 'Visit', food: 'Food check', prayer: 'Prayer', transfer: 'Transfer' } as const;
---
<Base pageClass="japan-page travel-page guide-detail-page" title={`${page.title} | Japan Travel Planner`} description={page.summary}>
  <GuideSubnav guide="travel" />
  <header class="guide-detail-header">
    <div><a class="guide-back" href="/japan-travel">Japan Travel overview</a><span lang="ja">{page.japanese}</span><h1>{page.title}</h1><p>{page.summary}</p></div>
    <EditorialImage image={editorialImage} label={page.title} className="guide-detail-image" loading="eager" position="center" />
  </header>

  {slug === 'itinerary' && (
    <section class="guide-detail-content itinerary-section" aria-label="Seven-day itinerary">
      <div class="day-list">
        {itinerary.map((item, index) => (
          <details class="day-panel" open={index === 0}>
            <summary><span class="route-node" aria-hidden="true"></span><span class="day-number">{String(item.day).padStart(2, '0')}</span><span class="day-title"><strong>{item.title}</strong><small>{item.base}</small></span><span class="summary-action"><span class="closed-label">Show stops</span><span class="open-label">Hide stops</span><i aria-hidden="true"></i></span></summary>
            <ol class="stop-list">{item.stops.map((stop) => <li><span class={`stop-type ${stop.type}`}>{typeLabels[stop.type]}</span><div><h2>{stop.place}</h2><p>{stop.note}</p></div><a href={mapLink(`${stop.place} ${stop.area}`)} target="_blank" rel="noreferrer">Open map</a></li>)}</ol>
          </details>
        ))}
      </div>
    </section>
  )}

  {slug === 'muslim-friendly' && (
    <section class="guide-detail-content muslim-planning" aria-label="Muslim-friendly planning checks">
      <div class="planning-principle"><strong>Verify on the same day.</strong><p>Prayer facilities, menus, kitchen practices, certifications, and opening hours can change. Keep one backup near your hotel or major station.</p></div>
      <div class="planning-groups">
        <article><h2>Prayer</h2><ul><li>Confirm access hours and whether advance contact is needed.</li><li>Carry a compact prayer mat and offline qibla direction.</li><li>Save a mosque or verified prayer-space backup.</li></ul></article>
        <article><h2>Food</h2><ul><li>Ask about ingredients, alcohol, pork derivatives, and shared cooking equipment.</li><li>Do not assume “no pork” means halal.</li><li>Keep a simple supermarket or convenience-store backup you have checked.</li></ul></article>
        <article><h2>Travel day</h2><ul><li>Group meals and prayers near the same station when possible.</li><li>Recheck venue announcements before a long transfer.</li><li>Save Japanese text for dietary questions on your phone.</li></ul></article>
        <aside><strong>Official starting point</strong><p>Use the Japan National Tourism Organization guide for general planning, then confirm each venue directly.</p><a href="https://www.japan.travel/en/my/muslim-guide/travel-ideas/japans-muslim-friendly-tourism-what-travelers-need-to-know/" target="_blank" rel="noreferrer">Open JNTO Muslim guide</a></aside>
      </div>
    </section>
  )}

  {slug === 'shopping' && (
    <section class="guide-detail-content shopping-section" aria-label="Shopping directory">
      <div class="shopping-toolbar"><div class="city-filter" role="group" aria-label="Filter shopping areas by city"><button type="button" class="city-filter-button active" data-city-filter="All" aria-pressed="true">All</button><button type="button" class="city-filter-button" data-city-filter="Tokyo" aria-pressed="false">Tokyo</button><button type="button" class="city-filter-button" data-city-filter="Osaka" aria-pressed="false">Osaka</button></div><p class="filter-status" data-filter-status aria-live="polite">Showing all {shoppingSpots.length} areas</p></div>
      <div class="shopping-directory"><div class="directory-head" aria-hidden="true"><span>Interest</span><span>Area</span><span>Planning note</span><span>Map</span></div>{shoppingSpots.map((spot) => <article class="shopping-item" data-city={spot.city}><div class="shopping-interest"><small>{spot.city}</small><h2>{spot.interest}</h2></div><strong>{spot.area}</strong><p>{spot.note}</p><a href={mapLink(`${spot.area} ${spot.city}`)} target="_blank" rel="noreferrer">View map</a></article>)}</div>
    </section>
  )}

  {slug === 'secondhand' && (
    <section class="guide-detail-content secondhand-section" aria-label="Second-hand shopping guide">
      <div class="secondhand-store-grid">
        {secondhandStores.map((store, index) => <article class="secondhand-store"><header><span>{String(index + 1).padStart(2, '0')}</span><div><h2>{store.name}</h2><p lang="ja">{store.japaneseName}</p></div></header><strong>{store.bestFor}</strong><small>{store.areas}</small><p>{store.note}</p><div class="secondhand-actions"><a href={store.inventoryUrl} target="_blank" rel="noreferrer">Official inventory</a><a href={mapLink(store.mapQuery)} target="_blank" rel="noreferrer">Find branches</a></div></article>)}
      </div>
      <div class="secondhand-checks"><article><h2>Camera check</h2><ul><li>Sensor dust, dead pixels, autofocus, stabilization, and shutter operation</li><li>Lens fungus, haze, scratches, aperture blades, and mount compatibility</li><li>Battery, charger, caps, cables, menu languages, and stated defects</li></ul></article><article><h2>Computer check</h2><ul><li>Battery and SSD health, screen, keyboard, trackpad, ports, Wi-Fi, and webcam</li><li>Japanese keyboard layout, charger voltage, OS activation, reset status, and accessories</li><li>Desktop dimensions, weight, safe packing, baggage limits, and import obligations</li></ul></article><aside><strong>Before payment</strong><p>Ask about condition grade, returns, initial-failure support, warranty outside Japan, and tax-free eligibility. Keep the receipt and photograph the serial number.</p></aside></div>
    </section>
  )}

  {slug === 'sources' && (
    <section class="guide-detail-content source-page" aria-label="Travel source material">
      <div class="source-page-grid"><figure><a href="/images/japan-source/travel-shopping.webp" target="_blank"><img src="/images/japan-source/travel-shopping.webp" alt="Supplied list of Tokyo and Osaka shopping areas" width="591" height="1280" loading="lazy" decoding="async" /></a><figcaption>Shopping list supplied by the user</figcaption></figure><figure><a href="/images/japan-source/travel-itinerary-1.webp" target="_blank"><img src="/images/japan-source/travel-itinerary-1.webp" alt="First page of the supplied seven-day Japan itinerary" width="591" height="1280" loading="lazy" decoding="async" /></a><figcaption>Itinerary reference, page 1</figcaption></figure><figure><a href="/images/japan-source/travel-itinerary-2.webp" target="_blank"><img src="/images/japan-source/travel-itinerary-2.webp" alt="Second page of the supplied seven-day Japan itinerary" width="591" height="1280" loading="lazy" decoding="async" /></a><figcaption>Itinerary reference, page 2</figcaption></figure></div>
      <aside class="source-note"><strong>How these are used</strong><p>The screenshots are planning references, not proof that prices, stores, menus, or commercial claims remain current. Live links and official sources take priority.</p><a href="https://github.com/haikalshiddiq/jlpt-zero-to-n1/blob/main/IMAGE_CREDITS.md" target="_blank" rel="noreferrer">View image licensing record</a></aside>
    </section>
  )}

  {slug === 'shopping' && <script is:inline>
    const filterButtons=[...document.querySelectorAll('[data-city-filter]')]; const shoppingItems=[...document.querySelectorAll('[data-city]')]; const filterStatus=document.querySelector('[data-filter-status]'); filterButtons.forEach((button)=>button.addEventListener('click',()=>{const city=button.dataset.cityFilter;let visible=0;filterButtons.forEach((candidate)=>{const selected=candidate===button;candidate.classList.toggle('active',selected);candidate.setAttribute('aria-pressed',String(selected));});shoppingItems.forEach((item)=>{const show=city==='All'||item.dataset.city===city;item.hidden=!show;if(show)visible+=1;});if(filterStatus)filterStatus.textContent=city==='All'?`Showing all ${visible} areas`:`Showing ${visible} areas in ${city}`;}));
  </script>}
</Base>
