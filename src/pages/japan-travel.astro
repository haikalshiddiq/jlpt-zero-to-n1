---
import Base from '../layouts/Base.astro';
import EditorialImage from '../components/EditorialImage.astro';
import GuideSubnav from '../components/GuideSubnav.astro';
import { travelNavigation } from '../data/japan-navigation';
import japanImages from '../data/japan-image-credits.json';
import '../styles/japan-life.css';

const imageById = Object.fromEntries(japanImages.map((image) => [image.id, image]));
const sections = travelNavigation.slice(1).map((section) => ({ ...section, image: imageById[section.imageId ?? 'travel-hero'] }));
---
<Base pageClass="japan-page travel-page guide-hub-page" title="Japan Travel Planner | JLPT Zero to N1" description="Open a focused Japan travel guide for itinerary, Muslim-friendly planning, shopping, second-hand gear, or source material.">
  <GuideSubnav guide="travel" />
  <header class="guide-hub-hero">
    <div class="hero-copy">
      <p class="japan-kicker"><span>旅</span> Japan Travel Planner</p>
      <h1>Choose one part<br /><em>of the journey.</em></h1>
      <p class="japan-intro">Each topic now has its own shorter page, so you can open what you need without scrolling through the entire guide.</p>
    </div>
    <EditorialImage image={imageById['travel-hero']} label="Tokyo / Mount Fuji" className="guide-hub-image" loading="eager" position="center 45%" />
  </header>

  <section class="guide-menu" aria-label="Japan Travel pages">
    {sections.map((section, index) => (
      <article id={section.href.split('/').pop()} class={index === 0 ? 'guide-menu-item featured' : 'guide-menu-item'}>
        <EditorialImage image={section.image} label={section.title} className="guide-menu-image" position="center" />
        <div class="guide-menu-copy">
          <span lang="ja">{section.japanese}</span>
          <h2>{section.title}</h2>
          <p>{section.summary}</p>
          <a href={section.href}>Open {section.label.toLowerCase()}</a>
        </div>
      </article>
    ))}
  </section>
</Base>
