---
import Base from '../layouts/Base.astro';
import { lessons } from '../lib/curriculum';
import { toRomaji } from '../utils/romaji';
---
<Base title="Reading">
  <div class="glass">
    <h1 style="margin:0 0 8px;font-size:1.75rem;font-weight:800">Reading Practice</h1>
    <p class="lead">Practice reading Japanese text with romaji support.</p>
  </div>
  <section class="grid">
    {lessons.map((lesson) => (
      <div class="card">
        <span class="badge">{lesson.level}</span>
        <h2 style="margin:8px 0;font-weight:700">{lesson.title}</h2>
        <pre>{lesson.reading}</pre>
        <pre class="romaji-block">{toRomaji(lesson.reading)}</pre>
        <button class="btn" data-toggle={`#q-${lesson.id}`}>Show Questions</button>
        <div id={`q-${lesson.id}`} class="hidden" style="margin-top:8px">
          {lesson.questions.map((question: string) => <p>&bull; {question}</p>)}
        </div>
      </div>
    ))}
  </section>
</Base>
