---
import Base from '../layouts/Base.astro';
import { officialSources, sswFieldsFromScreenshot, workSteps } from '../data/japan-life';
import '../styles/japan-life.css';
---
<Base title="Work in Japan Guide | JLPT Zero to N1" description="A source-backed guide for Indonesians researching legal work routes to Japan, including SSW, employer checks, COE, visa, and KP2MI/BP2MI procedures.">
  <header class="japan-hero work-hero">
    <div>
      <p class="japan-kicker">Work in Japan</p>
      <h1>Build a legal route to work in Japan.</h1>
      <p class="japan-intro">Start with the visa route, verify the employer, read the contract, and complete the official process in Japan and Indonesia.</p>
      <div class="mission-row">
        <a class="btn" href="#work-path">Start the checklist</a>
        <a class="text-action" href="#official-sources">Open official sources</a>
      </div>
    </div>
    <aside class="work-principle">
      <span>自分で確認</span>
      <h2>Verify it yourself</h2>
      <p>Independent does not mean unprotected. Use official sources and keep a written record of every fee, promise, and contract term.</p>
    </aside>
  </header>

  <section class="travel-notice warning-notice" aria-labelledby="not-a-package">
    <div>
      <h2 id="not-a-package">This is guidance, not a placement offer</h2>
      <p>The screenshots advertise a paid guide and make savings claims. This page does not endorse the seller, repeat its price, guarantee a job, or promise a visa.</p>
    </div>
    <a href="https://www.mofa.go.jp/j_info/visit/visa/long/index.html" target="_blank" rel="noreferrer">Check visa categories</a>
  </section>

  <section class="work-reference" aria-labelledby="work-reference-title">
    <figure>
      <a href="/images/japan-source/work-guide-source.webp" target="_blank" aria-label="Open the full-size supplied work guide screenshot">
        <img src="/images/japan-source/work-guide-source.webp" alt="Supplied promotional screenshot about independently applying for work in Japan" width="591" height="1280" loading="eager" decoding="async" />
      </a>
      <figcaption>User-supplied reference. Open for full size. The seller and promotional claims are not endorsed.</figcaption>
    </figure>
    <div>
      <h2 id="work-reference-title">We kept the useful outline and rebuilt the advice.</h2>
      <p>The screenshot identifies practical topics such as Tokutei Ginou, company research, Japanese calls, application email, passport, documents, and departure.</p>
      <p>This guide connects those topics to official sources and removes the price, savings claim, and implied job guarantee.</p>
    </div>
  </section>

  <section class="japan-section route-chooser" aria-labelledby="route-title">
    <div class="section-heading">
      <h2 id="route-title">Choose the route before the job board</h2>
      <p>Job title, duties, education, experience, Japanese ability, and exam results determine which status of residence may fit.</p>
    </div>
    <div class="route-comparison">
      <article>
        <span>特定技能</span>
        <h3>Specified Skilled Worker</h3>
        <p>Field-based route with skills and Japanese-language requirements. The official SSW site lists the current fields, tests, and support structure.</p>
        <a href="https://www.ssw.go.jp/en/about/visa/" target="_blank" rel="noreferrer">Check SSW requirements</a>
      </article>
      <article>
        <span>就労ビザ</span>
        <h3>Professional working visas</h3>
        <p>Routes include Engineer, Specialist in Humanities, International Services, Instructor, Professor, and other categories. Duties must match the selected status.</p>
        <a href="https://www.mofa.go.jp/j_info/visit/visa/long/visa1.html" target="_blank" rel="noreferrer">Review working visas</a>
      </article>
    </div>
    <div class="field-line" aria-label="Fields shown in the supplied screenshot">
      <strong>SSW examples shown in the screenshot:</strong>
      <ul>{sswFieldsFromScreenshot.map((field) => <li>{field}</li>)}</ul>
      <p>These are examples, not the complete official field list.</p>
    </div>
  </section>

  <section id="work-path" class="japan-section" aria-labelledby="work-path-title">
    <div class="section-heading">
      <h2 id="work-path-title">Your independent application checklist</h2>
      <p>Progress is stored only in this browser. Check an item after you have completed and documented it.</p>
    </div>
    <div class="checklist-progress" aria-live="polite">
      <strong data-checklist-count>0 of {workSteps.length} complete</strong>
      <span><i data-checklist-bar></i></span>
    </div>
    <ol class="work-steps">
      {workSteps.map((step, index) => (
        <li>
          <label>
            <input type="checkbox" data-work-check={String(index)} />
            <span class="check-box" aria-hidden="true"></span>
            <span class="work-step-copy">
              <strong>{step.title}</strong>
              <small>{step.detail}</small>
            </span>
          </label>
          <a href={step.href} target="_blank" rel="noreferrer">{step.action}</a>
        </li>
      ))}
    </ol>
    <button type="button" class="reset-checklist" data-reset-checklist>Reset checklist</button>
  </section>

  <section class="japan-section document-section" aria-labelledby="document-title">
    <div class="section-heading">
      <h2 id="document-title">What the screenshot’s course outline becomes here</h2>
      <p>The useful topics are retained as a practical document set. Old or ambiguous terminology must be checked against current official requirements.</p>
    </div>
    <div class="document-groups">
      <article>
        <h3>Application</h3>
        <ul>
          <li>Japanese rirekisho and work history</li>
          <li>Company research and vacancy review</li>
          <li>Japanese phone-call preparation</li>
          <li>Short Japanese application email</li>
        </ul>
      </article>
      <article>
        <h3>Identity and eligibility</h3>
        <ul>
          <li>Passport and civil documents</li>
          <li>Skills and language test evidence</li>
          <li>Employment contract and written conditions</li>
          <li>Certificate of Eligibility process</li>
        </ul>
      </article>
      <article>
        <h3>Protection and departure</h3>
        <ul>
          <li>Official KP2MI/BP2MI registration</li>
          <li>Visa application</li>
          <li>Insurance, housing, and emergency contacts</li>
          <li>Arrival and daily-life preparation</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="fraud-check" aria-labelledby="fraud-title">
    <div>
      <h2 id="fraud-title">Pause when a recruiter does this</h2>
      <p>Do not send money or original documents until the company, role, route, and written terms are verified.</p>
    </div>
    <ul>
      <li>Guarantees a visa or job before screening</li>
      <li>Hides the employer’s legal name or work location</li>
      <li>Requests payment without an itemized written agreement</li>
      <li>Uses only personal chat accounts and refuses official documentation</li>
      <li>Asks you to enter Japan as a tourist and work</li>
    </ul>
  </section>

  <section id="official-sources" class="japan-section" aria-labelledby="sources-title">
    <div class="section-heading">
      <h2 id="sources-title">Official starting points</h2>
      <p>Requirements change. Recheck these sources before submitting documents or paying any fee.</p>
    </div>
    <div class="official-links">
      {officialSources.map((source) => (
        <a href={source.href} target="_blank" rel="noreferrer">
          <strong>{source.name}</strong>
          <span>{source.label}</span>
        </a>
      ))}
    </div>
  </section>

  <script is:inline>
    const storageKey = 'jlpt-work-japan-checklist';
    const checks = [...document.querySelectorAll('[data-work-check]')];
    const count = document.querySelector('[data-checklist-count]');
    const bar = document.querySelector('[data-checklist-bar]');

    function readSavedChecks() {
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) || '[]');
        return Array.isArray(saved) ? saved.map(String) : [];
      } catch {
        return [];
      }
    }

    function renderProgress() {
      const completed = checks.filter((checkbox) => checkbox.checked).length;
      if (count) count.textContent = `${completed} of ${checks.length} complete`;
      if (bar) bar.style.width = `${checks.length ? (completed / checks.length) * 100 : 0}%`;
    }

    const savedChecks = readSavedChecks();
    checks.forEach((checkbox) => {
      checkbox.checked = savedChecks.includes(checkbox.dataset.workCheck);
      checkbox.addEventListener('change', () => {
        const completed = checks.filter((item) => item.checked).map((item) => item.dataset.workCheck);
        localStorage.setItem(storageKey, JSON.stringify(completed));
        renderProgress();
      });
    });

    document.querySelector('[data-reset-checklist]')?.addEventListener('click', () => {
      checks.forEach((checkbox) => { checkbox.checked = false; });
      localStorage.removeItem(storageKey);
      renderProgress();
    });

    renderProgress();
  </script>
</Base>
