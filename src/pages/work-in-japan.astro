---
import Base from '../layouts/Base.astro';
import EditorialImage from '../components/EditorialImage.astro';
import GuideSubnav from '../components/GuideSubnav.astro';
import { workNavigation } from '../data/japan-navigation';
import japanImages from '../data/japan-image-credits.json';
import '../styles/japan-life.css';

const imageById = Object.fromEntries(japanImages.map((image) => [image.id, image]));
const sections = workNavigation.slice(1).map((section) => ({ ...section, image: imageById[section.imageId ?? 'work-hero'] }));
---
<Base pageClass="japan-page work-page guide-hub-page" title="Work in Japan Guide | JLPT Zero to N1" description="Open a focused guide to Japan work visa routes, applications, documents, recruitment safety, or official sources.">
  <GuideSubnav guide="work" />
  <header class="guide-hub-hero">
    <div class="hero-copy">
      <p class="japan-kicker"><span>働</span> Work in Japan Guide</p>
      <h1>One decision<br /><em>at a time.</em></h1>
      <p class="japan-intro">Use a shorter page for each stage. Start with the legal route, then move through applications, documents, safety, and official verification.</p>
    </div>
    <EditorialImage image={imageById['work-hero']} label="Working life / Japan" className="guide-hub-image" loading="eager" position="center 45%" />
  </header>

  <aside class="hub-legal-note"><strong>Guidance, not a placement offer.</strong><p>No seller endorsement, job guarantee, price claim, or visa promise. Verify the employer, role, fees, and written terms independently.</p></aside>

  <section class="guide-menu" aria-label="Work in Japan pages">
    {sections.map((section, index) => (
      <article id={section.href.split('/').pop()} class={index === 0 ? 'guide-menu-item featured' : 'guide-menu-item'}>
        <EditorialImage image={section.image} label={section.title} className="guide-menu-image" position="center" />
        <div class="guide-menu-copy">
          <span lang="ja">{section.japanese}</span>
          <h2>{section.title}</h2>
          <p>{section.summary}</p>
          <a href={section.href}>Open {section.label.toLowerCase()}</a>
        </div>
      </article>
    ))}
  </section>
</Base>
