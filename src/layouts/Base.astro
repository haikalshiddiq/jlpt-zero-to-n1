---
import '../styles/global.css';

const {
  title = 'JLPT Zero to N1',
  description = 'Daily Japanese learning from absolute beginner to JLPT N1.'
} = Astro.props;
const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const navItems = [
  ['Daily Lesson','/daily-lesson'],
  ['Roadmap','/roadmap'],
  ['Japan Travel','/japan-travel'],
  ['Work in Japan','/work-in-japan'],
  ['Kotoba','/vocabulary'],
  ['Kana','/kana'],
  ['Kanji','/kanji'],
  ['Grammar','/grammar'],
  ['Reading','/reading'],
  ['Listening','/listening'],
  ['Practice','/practice'],
  ['JLPT Practice','/jlpt-practice'],
  ['Review','/review'],
  ['Progress','/progress']
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="JLPT Mastery" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('jlpt-theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="/">
          <span class="brand-mark">日</span>
          <strong>JLPT Zero to N1</strong>
          <small>Daily mastery path</small>
        </a>
        <nav>
          {navItems.map(([label, href]) => <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="side-mission">
          <span class="badge pulse">Live</span>
          <p>Daily CI/CD adds new quests and deploys through GitHub Actions.</p>
        </div>
        <button class="theme-toggle" id="theme-toggle" title="Toggle dark/light mode" aria-label="Toggle theme">
          <span class="light-icon">🌙</span>
          <span class="dark-icon hidden">☀️</span>
        </button>
      </aside>
      <main id="main-content"><slot /></main>
    </div>
    <script is:inline>
      window.jlptStore={
        get(k,d){try{return JSON.parse(localStorage.getItem(k))??d}catch{return d}},
        set(k,v){localStorage.setItem(k,JSON.stringify(v))}
      };

      // Theme toggle
      const toggle = document.getElementById('theme-toggle');
      const lightIcon = toggle?.querySelector('.light-icon');
      const darkIcon = toggle?.querySelector('.dark-icon');
      function updateThemeUI() {
        const isDark = document.documentElement.classList.contains('dark');
        if (lightIcon) lightIcon.classList.toggle('hidden', isDark);
        if (darkIcon) darkIcon.classList.toggle('hidden', !isDark);
      }
      updateThemeUI();
      toggle?.addEventListener('click', () => {
        const html = document.documentElement;
        if (html.classList.contains('dark')) {
          html.classList.remove('dark');
          localStorage.setItem('jlpt-theme', 'light');
        } else {
          html.classList.add('dark');
          localStorage.setItem('jlpt-theme', 'dark');
        }
        updateThemeUI();
      });

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js', { scope: '/' }));
      }

      // Delegate events
      document.addEventListener('click', e => {
        const t = e.target;
        const speakButton = t.closest?.('[data-speak]');
        if (speakButton) {
          const status = document.querySelector('[data-audio-status]');
          const text = speakButton.dataset.speak?.trim();
          if (!text || !('speechSynthesis' in window)) {
            if (status) status.textContent = 'Japanese speech is not available in this browser. Use the MP3 players on the Listening page.';
            return;
          }
          window.speechSynthesis.cancel();
          const utterance = new SpeechSynthesisUtterance(text);
          utterance.lang = 'ja-JP';
          utterance.rate = Number(speakButton.dataset.rate || 0.78);
          utterance.pitch = 1;
          const voices = window.speechSynthesis.getVoices();
          const japaneseVoice = voices.find((voice) => voice.lang.toLowerCase().startsWith('ja'));
          if (japaneseVoice) utterance.voice = japaneseVoice;
          speakButton.classList.add('is-speaking');
          if (status) status.textContent = `Playing: ${text}`;
          utterance.onend = () => {
            speakButton.classList.remove('is-speaking');
            if (status) status.textContent = 'Playback finished. Repeat it aloud, then play it again.';
          };
          utterance.onerror = () => {
            speakButton.classList.remove('is-speaking');
            if (status) status.textContent = 'Speech playback failed. Check that Japanese text-to-speech is enabled on your device.';
          };
          window.speechSynthesis.speak(utterance);
          return;
        }
        if (t.matches('[data-toggle]')) {
          const el = document.querySelector(t.dataset.toggle);
          el?.classList.toggle('hidden');
        }
        if (t.matches('[data-flip]')) {
          const card = t.closest('.flashcard');
          card?.classList.toggle('flipped');
        }
        if (t.matches('[data-review]')) {
          const q = jlptStore.get('reviewQueue', []);
          q.push({ item: t.dataset.item, result: t.dataset.review, date: new Date().toISOString() });
          jlptStore.set('reviewQueue', q);
          t.textContent = 'Saved';
        }
        if (t.matches('[data-answer]')) {
          const ok = t.dataset.answer === 'true';
          const fb = t.closest('.quiz-item')?.querySelector('.feedback');
          if (fb) fb.textContent = ok ? 'Correct!' : 'Review this one, try again.';
        }
        if (t.matches('[data-power]')) {
          const card = t.closest('.quest-card,.card');
          card?.classList.add('celebrate');
          setTimeout(() => card?.classList.remove('celebrate'), 900);
        }
      });
    </script>
  </body>
</html>
