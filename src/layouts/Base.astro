---
import '../styles/global.css';

const {
  title = 'JLPT Zero to N1',
  description = 'Daily Japanese learning from absolute beginner to JLPT N1.',
  pageClass = ''
} = Astro.props;
const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const navItems = [
  ['Daily Lesson','/daily-lesson'],
  ['Roadmap','/roadmap'],
  ['Japan Travel','/japan-travel'],
  ['Work in Japan','/work-in-japan'],
  ['Kotoba','/vocabulary'],
  ['Kana','/kana'],
  ['Kanji','/kanji'],
  ['Grammar','/grammar'],
  ['Reading','/reading'],
  ['Listening','/listening'],
  ['Practice','/practice'],
  ['JLPT Practice','/jlpt-practice'],
  ['Review','/review'],
  ['Progress','/progress']
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="JLPT Mastery" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('jlpt-theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <style is:inline>
      /* Keep the mobile shell stable while the full stylesheet streams. */
      @media (max-width: 768px) {
        html body .shell { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto; align-content: start; max-width: 100vw; overflow: hidden; }
        html body .shell main { min-width: 0; max-width: 100vw; }
        html body .sidebar { position: relative; width: 100%; min-width: 0; max-width: 100vw; height: auto; padding: 16px 20px 12px; gap: 12px; overflow: hidden; }
        .sidebar .brand { display: grid; grid-template-columns: 48px 1fr; grid-template-rows: auto auto; column-gap: 10px; align-items: center; padding-right: 48px; }
        .sidebar .brand-mark { grid-row: 1 / 3; width: 48px; height: 42px; border-radius: 12px; }
        html body .sidebar nav { flex: 0 0 auto; align-items: center; width: 100%; min-width: 0; max-width: 100%; flex-direction: row; gap: 6px; padding-bottom: 4px; overflow-x: auto; scrollbar-width: thin; }
        html body .sidebar nav a { flex: 0 0 auto; padding: 8px 11px; border: 1px solid var(--color-border); background: var(--color-surface); white-space: nowrap; }
        html body .sidebar .side-mission { display: none; }
        html body .sidebar .theme-toggle { position: absolute; top: 18px; right: 20px; }
        .japan-page .sidebar { padding: 22px 18px; }
        .japan-page .sidebar .brand-mark { width: 54px; height: 46px; border-radius: 4px; }
      }
    </style>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="/">
          <span class="brand-mark">日</span>
          <strong>JLPT Zero to N1</strong>
          <small>Daily mastery path</small>
        </a>
        <nav>
          {navItems.map(([label, href]) => {
            const active = currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
            return <a href={href} aria-current={active ? 'page' : undefined}>{label}</a>;
          })}
        </nav>
        <div class="side-mission">
          <span class="badge pulse">Live</span>
          <p>Daily CI/CD adds new quests and deploys through GitHub Actions.</p>
        </div>
        <button class="theme-toggle" id="theme-toggle" title="Toggle dark/light mode" aria-label="Toggle theme">
          <span class="light-icon">🌙</span>
          <span class="dark-icon hidden">☀️</span>
        </button>
      </aside>
      <main id="main-content"><slot /></main>
    </div>
    <div class="pwa-install-prompt hidden" id="pwa-install-prompt" role="region" aria-label="Install JLPT app">
      <p><strong>Study offline</strong><span>Install the JLPT app on this device.</span></p>
      <button class="pwa-install" id="pwa-install" type="button">Install</button>
      <button class="pwa-dismiss" id="pwa-dismiss" type="button" title="Dismiss install suggestion">Not now</button>
    </div>
    <script is:inline>
      window.jlptStore={
        get(k,d){try{return JSON.parse(localStorage.getItem(k))??d}catch{return d}},
        set(k,v){localStorage.setItem(k,JSON.stringify(v))}
      };

      // Theme toggle
      const toggle = document.getElementById('theme-toggle');
      const lightIcon = toggle?.querySelector('.light-icon');
      const darkIcon = toggle?.querySelector('.dark-icon');
      function updateThemeUI() {
        const isDark = document.documentElement.classList.contains('dark');
        if (lightIcon) lightIcon.classList.toggle('hidden', isDark);
        if (darkIcon) darkIcon.classList.toggle('hidden', !isDark);
      }
      updateThemeUI();
      toggle?.addEventListener('click', () => {
        const html = document.documentElement;
        if (html.classList.contains('dark')) {
          html.classList.remove('dark');
          localStorage.setItem('jlpt-theme', 'light');
        } else {
          html.classList.add('dark');
          localStorage.setItem('jlpt-theme', 'dark');
        }
        updateThemeUI();
      });

      if ('serviceWorker' in navigator) {
        const hadController = Boolean(navigator.serviceWorker.controller);
        let refreshingForUpdate = false;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (!hadController || refreshingForUpdate) return;
          refreshingForUpdate = true;
          window.location.reload();
        });
        window.addEventListener('load', async () => {
          try {
            const response = await fetch('/sw.js', { method: 'HEAD', cache: 'no-store' });
            if (response.ok) {
              const registration = await navigator.serviceWorker.register('/sw.js', { scope: '/' });
              await registration.update();
            }
          } catch (error) { console.warn('Offline mode is unavailable.', error); }
        });
      }

      let installPrompt;
      const installContainer = document.getElementById('pwa-install-prompt');
      const installButton = document.getElementById('pwa-install');
      const dismissButton = document.getElementById('pwa-dismiss');
      const hideInstall = () => {
        installContainer?.classList.add('hidden');
        document.body.classList.remove('pwa-prompt-visible');
      };
      window.addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();
        installPrompt = event;
        if (sessionStorage.getItem('jlpt-install-dismissed') !== '1') {
          installContainer?.classList.remove('hidden');
          document.body.classList.add('pwa-prompt-visible');
        }
      });
      installButton?.addEventListener('click', async () => {
        if (!installPrompt) return;
        installPrompt.prompt();
        await installPrompt.userChoice;
        installPrompt = null;
        hideInstall();
      });
      dismissButton?.addEventListener('click', () => { sessionStorage.setItem('jlpt-install-dismissed', '1'); hideInstall(); });
      window.addEventListener('appinstalled', () => {
        installPrompt = null;
        hideInstall();
      });

      // Delegate events
      document.addEventListener('click', e => {
        const t = e.target;
        const speakButton = t.closest?.('[data-speak]');
        if (speakButton) {
          const status = document.querySelector('[data-audio-status]');
          const localStatus = speakButton.closest?.('[data-kanji-card]')?.querySelector('[data-card-status]');
          const text = speakButton.dataset.speak?.trim();
          if (!text || !('speechSynthesis' in window)) {
            if (status) status.textContent = 'Japanese speech is not available in this browser. Use the MP3 players on the Listening page.';
            if (localStatus) localStatus.textContent = 'Japanese speech is not available in this browser.';
            return;
          }
          window.speechSynthesis.cancel();
          const utterance = new SpeechSynthesisUtterance(text);
          utterance.lang = 'ja-JP';
          utterance.rate = Number(speakButton.dataset.rate || 0.78);
          utterance.pitch = 1;
          const voices = window.speechSynthesis.getVoices();
          const japaneseVoice = voices.find((voice) => voice.lang.toLowerCase().startsWith('ja'));
          if (japaneseVoice) utterance.voice = japaneseVoice;
          speakButton.classList.add('is-speaking');
          if (status) status.textContent = `Playing: ${text}`;
          if (localStatus) localStatus.textContent = `Playing: ${text}`;
          utterance.onend = () => {
            speakButton.classList.remove('is-speaking');
            if (status) status.textContent = 'Playback finished. Repeat it aloud, then play it again.';
            if (localStatus) localStatus.textContent = 'Playback finished. Repeat it aloud, then play it again.';
          };
          utterance.onerror = () => {
            speakButton.classList.remove('is-speaking');
            if (status) status.textContent = 'Speech playback failed. Check that Japanese text-to-speech is enabled on your device.';
            if (localStatus) localStatus.textContent = 'Speech playback failed. Check Japanese text-to-speech on your device.';
          };
          window.speechSynthesis.speak(utterance);
          return;
        }
        if (t.matches('[data-toggle]')) {
          const el = document.querySelector(t.dataset.toggle);
          el?.classList.toggle('hidden');
        }
        if (t.matches('[data-flip]')) {
          const card = t.closest('.flashcard');
          card?.classList.toggle('flipped');
        }
        if (t.matches('[data-review]')) {
          const q = jlptStore.get('reviewQueue', []);
          if (!q.some((entry) => entry.item === t.dataset.item && entry.result === t.dataset.review)) {
            q.push({ item: t.dataset.item, result: t.dataset.review, date: new Date().toISOString() });
          }
          jlptStore.set('reviewQueue', q);
          t.textContent = 'In review';
          t.setAttribute('aria-pressed', 'true');
        }
        if (t.matches('[data-answer]')) {
          const ok = t.dataset.answer === 'true';
          const fb = t.closest('.quiz-item')?.querySelector('.feedback');
          if (fb) fb.textContent = ok ? 'Correct!' : 'Review this one, try again.';
        }
        if (t.matches('[data-power]')) {
          const card = t.closest('.quest-card,.card');
          card?.classList.add('celebrate');
          setTimeout(() => card?.classList.remove('celebrate'), 900);
        }
      });
    </script>
  </body>
</html>
